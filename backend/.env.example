# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=klinik_sekolah
DB_USER=postgres
