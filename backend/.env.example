# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=klinik_sekolah
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_anda

# SSL koneksi database.
# Wajib di-set true untuk provider cloud seperti Neon, Supabase, Railway, dll.
# Biarkan kosong atau false untuk PostgreSQL lokal (development).
DB_SSL=false

# ── JWT ───────────────────────────────────────────────────────────────────
# WAJIB: minimal 32 karakter acak. Server akan BERHENTI jika tidak di-set.
# Generate contoh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=jalankan_node_crypto_untuk_generate_baru
JWT_EXPIRES_IN=8h

# ── Frontend ─────────────────────────────────────────────────────────────
# Di production: isi dengan URL frontend yang sebenarnya, misal https://klinik.example.com
# Boleh lebih dari satu, pisahkan dengan koma: https://klinik.example.com,https://www.klinik.example.com
FRONTEND_URL=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────
# Level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Cloudinary (penyimpanan foto profil) ──────────────────────────────────
# Dapatkan nilai ini dari Cloudinary Dashboard → Settings → API Keys.
# Wajib di-set di production. Kosongkan untuk development jika tidak ada akun.
CLOUDINARY_CLOUD_NAME=isi_cloud_name_anda
CLOUDINARY_API_KEY=isi_api_key_anda
CLOUDINARY_API_SECRET=isi_api_secret_anda
